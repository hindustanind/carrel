# Copy to .env for local development.
DATABASE_URL=postgres://carrel:carrel@localhost:5544/carrel
SESSION_SECRET=dev-only-change-me-session   # production: 32+ random bytes, e.g. `openssl rand -base64 48`
QR_SECRET=dev-only-change-me-qr             # production: random; changing it invalidates every printed desk QR
PUBLIC_ORIGIN=http://localhost:8080         # the URL printed into desk QR codes (your real domain in production)
PORT=8080
TIME_SCALE=1                                # demo only: 20 makes the 10-min hold 30 s and the 20-min break 60 s
# SEED_DEMO=1                               # create demo accounts in production too (for judging)
